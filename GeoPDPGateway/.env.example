# Copy to .env (ignored by Git) and set your local ADLS credential.
AZURE_ACCESS_KEY=

# Any OIDC provider's access-token validation settings for the selector.
# OIDC_AUDIENCE must exactly match the token's aud claim.
OIDC_ISSUER=https://oidc.example/issuer
OIDC_AUDIENCE=REPLACE_WITH_TOKEN_AUDIENCE
OIDC_JWKS_URL=https://oidc.example/issuer/keys
OIDC_LOCATION_CLAIM=geo_location
TRINO_OAUTH_ENFORCED=false
TRINO_OAUTH_BOOTSTRAP_ROUTING_GROUP=unrestricted
