# Copy to .env (ignored by Git) and set your local ADLS credential.
AZURE_ACCESS_KEY=

# Microsoft Entra ID v2.0 access-token validation for the Gateway selector.
# OIDC_AUDIENCE must exactly match the token's aud claim.
OIDC_ISSUER=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0
OIDC_AUDIENCE=api://REPLACE_WITH_TRINO_API_APPLICATION_ID_URI
OIDC_JWKS_URL=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/discovery/v2.0/keys
OIDC_LOCATION_CLAIM=geo_location
TRINO_OAUTH_ENFORCED=false
TRINO_POLICY_ROUTING_GROUPS=unrestricted=adhoc,georestricted=georestricted
TRINO_OAUTH_BOOTSTRAP_ROUTING_GROUP=adhoc
